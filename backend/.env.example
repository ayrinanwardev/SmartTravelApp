# Copy this file to ".env" (same folder) and fill in your values.
# ".env" is git-ignored — never commit real passwords or secrets.

# ---------- Supabase database (Dashboard → Connect → "Session pooler") ----------
# Example host: aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_HOST=aws-0-YOUR-REGION.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
# Pooler user is "postgres.<project-ref>", e.g. postgres.abcdefghijklmnop
SUPABASE_DB_USER=postgres.YOUR-PROJECT-REF
# The database password you set when creating the project (Dashboard → Project Settings → Database → Reset if forgotten)
SUPABASE_DB_PASSWORD=

# Schema for Wanderly's tables (kept out of Supabase's public Data API on purpose)
DB_SCHEMA=wanderly

# ---------- App ----------
# Base64 key for signing login tokens. Leave commented out to use the built-in DEV key;
# set your own before deploying. Generate one in PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# JWT_SECRET=
# Load the 12 sample destinations, 10 hotels and the demo account on first start
SEED_DATA=true

# --- Payments (SSLCommerz) ---
# Public URL of this API: SSLCommerz redirects the browser and sends IPN here.
PUBLIC_BASE_URL=http://localhost:8080
# Defaults are SSLCommerz's public sandbox store. Use your merchant credentials for live.
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_SANDBOX=true

# --- Push notifications (Firebase Cloud Messaging) ---
# Base64 of the Firebase service-account JSON. Leave empty to disable push.
FIREBASE_CREDENTIALS_BASE64=
